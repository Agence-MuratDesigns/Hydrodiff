{{ 'customer.css' | asset_url | stylesheet_tag }}
{{ 'hydrodiff-login.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 0;
    padding-bottom: 0;
  }
{%- endstyle -%}

<div class="customer login hydrodiff-active section-{{ section.id }}-padding">
  <div class="hydrodiff-login">
    <!-- Form Container -->
    <div class="hydrodiff-login__form-container">

      <!-- Recovery Form (hidden by default, shown via anchor) -->
      <div id="recover" class="hydrodiff-login__recover"></div>
      <div class="hydrodiff-login__recover-form" style="display: none;">
        <h1 class="hydrodiff-login__title">
          {{ 'customer.recover_password.title' | t }}
        </h1>
        <p class="hydrodiff-login__subtitle">
          {{ 'customer.recover_password.subtext' | t }}
        </p>

        {%- form 'recover_customer_password' -%}
          {% assign recover_success = form.posted_successfully? %}

          {%- if form.errors -%}
            <div class="hydrodiff-login__error">
              <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
              {{ form.errors.messages.form }}
            </div>
          {%- endif -%}

          <div class="hydrodiff-login__form">
            <div class="hydrodiff-login__field">
              <label for="RecoverEmail" class="hydrodiff-login__label hydrodiff-login__label--required">
                {{ 'customer.login_page.email' | t }}
              </label>
              <input
                type="email"
                value=""
                name="email"
                id="RecoverEmail"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                class="hydrodiff-login__input"
                placeholder="exemple@email.com"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="RecoverEmail-email-error"
                  autofocus
                {% endif %}
              >
            </div>

            <button type="submit" class="hydrodiff-login__submit">
              <span>{{ 'customer.login_page.submit' | t }}</span>
              <span class="hydrodiff-login__submit-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </button>

            <a href="#login" class="hydrodiff-login__back-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
              </svg>
              {{ 'customer.login_page.cancel' | t }}
            </a>
          </div>
        {%- endform -%}
      </div>

      <!-- Main Login Form -->
      <div id="login" class="hydrodiff-login__main-form">
        <h1 class="hydrodiff-login__title">
          Accéder à votre espace client
        </h1>
        <p class="hydrodiff-login__subtitle">
          Connectez-vous à votre compte Hydrodiff pour retrouver vos commandes, gérer vos informations et suivre vos achats en toute simplicité.
        </p>

        {%- if recover_success == true -%}
          <div class="hydrodiff-login__success">
            <span class="svg-wrapper">{{- 'icon-success.svg' | inline_asset_content -}}</span>
            {{ 'customer.recover_password.success' | t }}
          </div>
        {%- endif -%}

        {%- form 'customer_login', novalidate: 'novalidate' -%}
          {%- if form.errors -%}
            <div class="hydrodiff-login__error">
              <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
              {{ 'templates.contact.form.error_heading' | t }}
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="hydrodiff-login__form">
            <div class="hydrodiff-login__field">
              <label for="CustomerEmail" class="hydrodiff-login__label hydrodiff-login__label--required">
                Votre adresse e-mail
              </label>
              <input
                type="email"
                name="customer[email]"
                id="CustomerEmail"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                class="hydrodiff-login__input"
                placeholder="exemple@email.com"
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                {% endif %}
              >
            </div>

            {%- if form.password_needed -%}
              <div class="hydrodiff-login__field">
                <label for="CustomerPassword" class="hydrodiff-login__label hydrodiff-login__label--required">
                  Votre mot de passe
                </label>
                <input
                  type="password"
                  value=""
                  name="customer[password]"
                  id="CustomerPassword"
                  autocomplete="current-password"
                  class="hydrodiff-login__input"
                  placeholder="••••••••••••"
                  {% if form.errors contains 'form' %}
                    aria-invalid="true"
                  {% endif %}
                >
              </div>

              <div class="hydrodiff-login__forgot-password">
                <a href="#recover">Mot de passe oublié ?</a>
              </div>
            {%- endif -%}

            <button type="submit" class="hydrodiff-login__submit">
              <span>Se connecter</span>
              <span class="hydrodiff-login__submit-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </button>

            <div class="hydrodiff-login__links">
              <p class="hydrodiff-login__register">
                Vous n'avez pas de compte? <a href="{{ routes.account_register_url }}">Inscrivez-vous</a>
              </p>

              {%- if shop.checkout.guest_login -%}
                <div class="hydrodiff-login__guest">
                  {%- form 'guest_login' -%}
                    <button type="submit">Continuer en tant qu'invité</button>
                  {%- endform -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endform -%}
      </div>
    </div>

    <!-- Image Container -->
    <div class="hydrodiff-login__image-container">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image.alt | default: 'Espace client Hydrodiff' }}"
          class="hydrodiff-login__image"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <img
          src="https://images.unsplash.com/photo-1560250097-0b93528c311a?w=800&h=1000&fit=crop&q=80"
          alt="Espace client Hydrodiff"
          class="hydrodiff-login__image"
          loading="lazy"
        >
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  // Handle recover form visibility
  document.addEventListener('DOMContentLoaded', function() {
    const recoverForm = document.querySelector('.hydrodiff-login__recover-form');
    const mainForm = document.querySelector('.hydrodiff-login__main-form');

    function checkHash() {
      if (window.location.hash === '#recover') {
        recoverForm.style.display = 'block';
        mainForm.style.display = 'none';
      } else {
        recoverForm.style.display = 'none';
        mainForm.style.display = 'block';
      }
    }

    checkHash();
    window.addEventListener('hashchange', checkHash);
  });
</script>

{% schema %}
{
  "name": "Connexion Hydrodiff",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image de la page de connexion",
      "info": "Recommandé: 800x1000px. L'image sera affichée à droite du formulaire."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Accéder à votre espace client"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Connectez-vous à votre compte Hydrodiff pour retrouver vos commandes, gérer vos informations et suivre vos achats en toute simplicité."
    },
    {
      "type": "header",
      "content": "Bouton Shop Login"
    },
    {
      "type": "checkbox",
      "id": "enable_shop_login_button",
      "label": "t:sections.main-login.shop_login_button.enable",
      "default": false
    }
  ]
}
{% endschema %}
