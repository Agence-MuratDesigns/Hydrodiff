{{ 'hydrodiff-footer.css' | asset_url | stylesheet_tag }}

<footer class="hydrodiff-footer">
  <div class="hydrodiff-footer__inner">
    <!-- Main Grid -->
    <div class="hydrodiff-footer__grid">

      <!-- Column 1: Brand -->
      <div class="hydrodiff-footer__brand">
        <a href="{{ routes.root_url }}" class="hydrodiff-footer__logo">
          {{ section.settings.logo_text | default: 'HYDRODIFF' }}
        </a>

        <p class="hydrodiff-footer__description">
          {{ section.settings.description | default: 'Votre partenaire de confiance pour le matériel de chauffage et plomberie. Qualité professionnelle, prix compétitifs, livraison rapide partout en France.' }}
        </p>

        <div class="hydrodiff-footer__contact">
          {%- if section.settings.phone != blank -%}
            <a href="tel:{{ section.settings.phone | remove: ' ' }}" class="hydrodiff-footer__contact-item">
              <span class="hydrodiff-footer__contact-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </span>
              <span>{{ section.settings.phone }}</span>
            </a>
          {%- endif -%}

          {%- if section.settings.email != blank -%}
            <a href="mailto:{{ section.settings.email }}" class="hydrodiff-footer__contact-item">
              <span class="hydrodiff-footer__contact-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </span>
              <span>{{ section.settings.email }}</span>
            </a>
          {%- endif -%}
        </div>

        <a href="{{ section.settings.cta_link | default: routes.collections_url }}" class="hydrodiff-footer__cta">
          <span>{{ section.settings.cta_text | default: 'Voir nos produits' }}</span>
          <span class="hydrodiff-footer__cta-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
      </div>

      <!-- Column 2: Menu -->
      <nav class="hydrodiff-footer__menu">
        <h3 class="hydrodiff-footer__menu-title">Menu</h3>
        <ul class="hydrodiff-footer__menu-list">
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ routes.collections_url }}" class="hydrodiff-footer__menu-link">Boutique</a>
          </li>
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ section.settings.brands_link | default: '/pages/marques' }}" class="hydrodiff-footer__menu-link">Toutes nos marques</a>
          </li>
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ section.settings.promo_link | default: '/collections/promotions' }}" class="hydrodiff-footer__menu-link hydrodiff-footer__menu-link--promo">Promotions</a>
          </li>
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ section.settings.installer_link | default: '/pages/trouver-installateur' }}" class="hydrodiff-footer__menu-link hydrodiff-footer__menu-link--highlight">Trouver un installateur</a>
          </li>
        </ul>
      </nav>

      <!-- Column 3: Plus -->
      <nav class="hydrodiff-footer__menu">
        <h3 class="hydrodiff-footer__menu-title">Plus</h3>
        <ul class="hydrodiff-footer__menu-list">
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ pages['contact'].url | default: '/pages/contact' }}" class="hydrodiff-footer__menu-link">Contact / Support</a>
          </li>
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ pages['a-propos'].url | default: '/pages/a-propos' }}" class="hydrodiff-footer__menu-link">À propos</a>
          </li>
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ pages['faq'].url | default: '/pages/faq' }}" class="hydrodiff-footer__menu-link">Questions fréquentes</a>
          </li>
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ pages['livraison'].url | default: '/pages/livraison' }}" class="hydrodiff-footer__menu-link">Informations de livraisons</a>
          </li>
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ shop.policies.refund_policy.url | default: '/policies/refund-policy' }}" class="hydrodiff-footer__menu-link">Retours & Rétractation</a>
          </li>
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ pages['garantie'].url | default: '/pages/garantie' }}" class="hydrodiff-footer__menu-link">SAV & Garantie</a>
          </li>
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ pages['paiement'].url | default: '/pages/paiement-securise' }}" class="hydrodiff-footer__menu-link">Paiement sécurisé</a>
          </li>
        </ul>
      </nav>

      <!-- Column 4: Compte -->
      <nav class="hydrodiff-footer__menu">
        <h3 class="hydrodiff-footer__menu-title">Compte</h3>
        <ul class="hydrodiff-footer__menu-list">
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ routes.account_url }}" class="hydrodiff-footer__menu-link">Historique de commandes</a>
          </li>
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ routes.account_addresses_url }}" class="hydrodiff-footer__menu-link">Mes adresses</a>
          </li>
          <li class="hydrodiff-footer__menu-item">
            <a href="{{ routes.cart_url }}" class="hydrodiff-footer__menu-link">Mon panier</a>
          </li>
          {%- if customer -%}
            <li class="hydrodiff-footer__menu-item">
              <a href="{{ routes.account_logout_url }}" class="hydrodiff-footer__menu-link hydrodiff-footer__menu-link--muted">Se déconnecter</a>
            </li>
          {%- else -%}
            <li class="hydrodiff-footer__menu-item">
              <a href="{{ routes.account_login_url }}" class="hydrodiff-footer__menu-link hydrodiff-footer__menu-link--muted">Se connecter</a>
            </li>
          {%- endif -%}
        </ul>
      </nav>

    </div>

    <!-- Bottom Bar -->
    <div class="hydrodiff-footer__bottom">
      <div class="hydrodiff-footer__bottom-inner">
        <p class="hydrodiff-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits réservés.
        </p>

        <ul class="hydrodiff-footer__legal">
          <li>
            <a href="{{ pages['mentions-legales'].url | default: '/pages/mentions-legales' }}" class="hydrodiff-footer__legal-link">Mentions légales</a>
          </li>
          <li>
            <a href="{{ shop.policies.privacy_policy.url | default: '/policies/privacy-policy' }}" class="hydrodiff-footer__legal-link">Politique de confidentialité</a>
          </li>
          <li>
            <a href="{{ pages['cookies'].url | default: '/pages/cookies' }}" class="hydrodiff-footer__legal-link">Politique de cookies</a>
          </li>
          <li>
            <a href="{{ shop.policies.terms_of_service.url | default: '/policies/terms-of-service' }}" class="hydrodiff-footer__legal-link">CGV</a>
          </li>
          <li>
            <a href="{{ pages['cgu'].url | default: '/pages/cgu' }}" class="hydrodiff-footer__legal-link">CGU</a>
          </li>
          <li>
            <a href="{{ pages['donnees-personnelles'].url | default: '/pages/donnees-personnelles' }}" class="hydrodiff-footer__legal-link">Données personnelles</a>
          </li>
        </ul>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer Hydrodiff",
  "settings": [
    {
      "type": "header",
      "content": "Bloc Marque"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Texte du logo",
      "default": "HYDRODIFF"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Votre partenaire de confiance pour le matériel de chauffage et plomberie. Qualité professionnelle, prix compétitifs, livraison rapide partout en France."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Téléphone",
      "default": "+33 6 23 45 67 89"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "contact@hydrodiff.com"
    },
    {
      "type": "header",
      "content": "Bouton CTA"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texte du bouton",
      "default": "Voir nos produits"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Liens Menu"
    },
    {
      "type": "url",
      "id": "brands_link",
      "label": "Lien 'Toutes nos marques'"
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "Lien 'Promotions'"
    },
    {
      "type": "url",
      "id": "installer_link",
      "label": "Lien 'Trouver un installateur'"
    }
  ]
}
{% endschema %}
